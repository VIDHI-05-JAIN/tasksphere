[Unit]
Description=TaskSphere Gunicorn service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tasksphere
Environment="PATH=/home/ubuntu/tasksphere/venv/bin"
ExecStart=/home/ubuntu/tasksphere/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile /var/log/tasksphere/access.log --error-logfile /var/log/tasksphere/error.log app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target